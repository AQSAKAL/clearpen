{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!**/node_modules", "!**/dist", "!**/*.md", "!pnpm-lock.yaml"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "off", "useTemplate": "off" },
      "complexity": { "noExcessiveCognitiveComplexity": "off" },
      "suspicious": { "noControlCharactersInRegex": "off" }
    }
  }
}
